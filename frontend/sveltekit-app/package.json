{
	"name": "@mediflow-ai/sveltekit-app",
	"version": "0.0.1",
	"description": "MediFlow AI - Healthcare operations platform with multi-agent AI coordination using Amazon Bedrock",
	"author": "Mudiaga Arharhire",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/mudiageo/mediflow-ai.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"publint": "^0.3.13",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"healthcare",
		"ai",
		"agents",
		"aws",
		"bedrock",
		"medical",
		"hospital-operations",
		"patient-care",
		"medication-management"
	],
	"dependencies": {
		"@aws-sdk/client-api-gateway": "^3.901.0",
		"@aws-sdk/client-bedrock-agent-runtime": "^3.901.0",
		"@aws-sdk/client-bedrock-runtime": "^3.901.0",
		"@aws-sdk/client-dynamodb": "^3.902.0",
		"@aws-sdk/client-s3": "^3.901.0",
		"@aws-sdk/lib-dynamodb": "^3.902.0"
	}
}
