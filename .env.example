# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Bedrock Configuration
BEDROCK_AGENT_CORE_ARN=arn:aws:bedrock:region:account:agent/agent-id
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_NOVA_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon Q Configuration
AMAZON_Q_APPLICATION_ID=your-q-app-id
AMAZON_Q_INDEX_ID=your-q-index-id

# DynamoDB Tables
DYNAMODB_PATIENTS_TABLE=mediflow-patients
DYNAMODB_MEDICATIONS_TABLE=mediflow-medications
DYNAMODB_OPERATIONS_TABLE=mediflow-operations

# S3 Buckets
S3_PATIENT_RECORDS_BUCKET=mediflow-patient-records
S3_LOGS_BUCKET=mediflow-logs

# API Gateway
API_GATEWAY_URL=https://your-api-gateway-url

# External APIs
FDA_API_KEY=your-fda-api-key
FDA_API_URL=https://api.fda.gov/drug/
PHARMACY_API_URL=https://mock-pharmacy-api.com

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Security
ENCRYPTION_KEY=your-encryption-key
JWT_SECRET=your-jwt-secret

# Monitoring
CLOUDWATCH_NAMESPACE=MediFlowAI
XRAY_ENABLED=true
